# Configuration for build.sh
# Every value can be overridden by an environment variable (e.g. in the GitHub Action).

# --- Base: official DietPi image for the Radxa ZERO 3 (same SoC, RK3566) ---
: "${DIETPI_IMAGE:=DietPi_RadxaZERO3-ARMv8-Trixie.img.xz}"
: "${DIETPI_URL:=https://dietpi.com/downloads/images}"

# --- Radxa BSP (kernel, bootloader, firmware) ---
: "${RADXA_KEYRING_URL:=https://github.com/radxa-pkg/radxa-archive-keyring/releases/download/0.2.2/radxa-archive-keyring_0.2.2_all.deb}"
: "${RADXA_KEYRING_SHA256:=3e3bb3d3150cf1dfa6c050d0c135f6a7f298b7638ff7e656fda711ababdb8a57}"
: "${RADXA_PRODUCT:=radxa-cm3-io}"      # name used by the u-boot-*/linux-* meta packages
: "${RADXA_SOC_REPO:=rk3566-bookworm}"  # SoC-specific Radxa repository
: "${RADXA_KERNEL_FLAVOR:=rk2410-nocsf}"

# --- Tridex Nexus software (own apt repository) ---
: "${NEXUS_KEYRING_URL:=https://tridexdarts.github.io/nexus-apt/nexus-archive-keyring.deb}"
# Leave empty if the keyring package may change; otherwise the sha256 of the .deb
: "${NEXUS_KEYRING_SHA256:=}"
: "${NEXUS_PACKAGES:=nexus}"

# --- System ---
: "${NEXUS_HOSTNAME:=nexus}"
: "${NEXUS_USER:=tridex}"
# NEXUS_USER has NO password and no SSH keys in the image: login is only possible
# once the first password has been set (later via the captive portal).
: "${NEXUS_GROUPS:=sudo adm audio video plugdev users render input netdev gpio spidev pwm i2c dialout}"
: "${NEXUS_LOCALE:=C.UTF-8}"
: "${NEXUS_KEYBOARD:=de}"
: "${NEXUS_TIMEZONE:=UTC}"

# --- Image ---
: "${IMAGE_NAME:=nexus}"
: "${BUILD_GROW_MIB:=2048}"   # extra space during the build
: "${IMAGE_FREE_MIB:=256}"    # headroom in the final image (it grows to full size on first boot anyway)
